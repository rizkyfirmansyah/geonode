## set host configuration for your separate database & platform
DB_GIS_HOST=localhost
DB_GIS_PORT=25432
# set to the same host as defined in the docker-compose; preventing the application to failure if any case the db is failure
DB_CMS_HOST=db-cms
DB_CMS_PORT=5432
ENABLE_JSONP=true
outFormat=text/javascript
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver!
GEOWEBCACHE_CACHE_DIR=/geoserver_data/data/gwc
GEOSERVER_LOG_LOCATION=/geoserver_data/logs
PUBLIC_PORT=80
GEOSERVER_VERSION=2.20.5
HTTP_HOST=localhost
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=rabbitmq!
SITEURL=http://localhost/
GEONODE_DATABASE=postgres
GEONODE_DATABASE_PASSWORD=postgres
GEONODE_DATABASE_GF=geofence
GEONODE_GEODATABASE_USER=geonode
GEONODE_GEODATABASE=geonode_data
GEONODE_GEODATABASE_PASSWORD=geonode
GEONODE_GEODATABASE_SCHEMA=public
GEOSERVER_DATA_DIR=/geoserver_data/data
GEONODE_MONITORING_DATABASE=monitoring
